<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<title>오늘의 1면 제목</title>
<style>
{{ font_css }}
  :root{
    --navy:#0d1f3c;
    --navy2:#17325c;
    --red:#b8272d;
    --gold:#c9a227;
    --ink:#141a24;
    --sub:#6b7688;
    --line:#dfe4ee;
    --paper:#fbfaf7;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    width:1080px;height:1350px;background:var(--paper);
    font-family:"Noto Sans KR","Apple SD Gothic Neo",sans-serif;
    color:var(--ink);word-break:keep-all;-webkit-font-smoothing:antialiased;
  }
  .myeong{font-family:"NanumMyeongjo","Noto Sans KR",serif;}
  .page{width:1080px;height:1350px;display:flex;flex-direction:column;overflow:hidden;}

  /* ---------- masthead ---------- */
  .mast{
    background:var(--navy);color:#fff;padding:16px 40px 14px;
    display:flex;align-items:baseline;gap:16px;border-bottom:4px solid var(--gold);
  }
  .mast .name{font-size:34px;font-weight:800;letter-spacing:-1.5px;}
  .mast .kicker{font-size:19px;font-weight:700;color:#a9bcd8;letter-spacing:0;}
  .mast .date{margin-left:auto;font-size:22px;font-weight:700;color:#e8eef8;}
  .mast .day{
    font-size:16px;font-weight:800;color:var(--navy);background:var(--gold);
    padding:4px 12px;border-radius:4px;margin-left:12px;
  }

  /* ---------- hero ---------- */
  .hero{position:relative;height:498px;overflow:hidden;background:#0d1f3c;}
  .hero > img{width:100%;height:100%;object-fit:cover;object-position:center 42%;display:block;}
  .hero .veil{
    position:absolute;inset:0;
    background:linear-gradient(180deg,rgba(13,31,60,0) 30%,rgba(13,31,60,.72) 62%,rgba(13,31,60,.95) 100%);
  }
  .hero .cap{position:absolute;left:40px;right:40px;bottom:26px;color:#fff;}
  .hero .tag{
    display:inline-flex;align-items:center;gap:9px;background:var(--red);
    font-size:18px;font-weight:800;letter-spacing:1px;padding:6px 15px;border-radius:3px;margin-bottom:14px;
  }
  .hero h1{
    margin:0;font-size:62px;line-height:1.13;font-weight:700;letter-spacing:-2.5px;
    text-shadow:0 2px 18px rgba(0,0,0,.45);
  }
  .hero .sub{
    margin-top:12px;font-size:24px;font-weight:600;color:#f0d99a;letter-spacing:-0.8px;
  }

  /* ---------- headline list ---------- */
  .list{flex:1;padding:6px 40px 0;display:flex;flex-direction:column;}
  .row{
    flex:1;display:flex;align-items:center;gap:20px;
    border-bottom:1.5px solid var(--line);
  }
  .row:last-child{border-bottom:none;}
  .row .idx{
    font-family:"NanumMyeongjo",serif;font-size:40px;font-weight:700;color:#c3ccdb;
    width:52px;flex:none;text-align:center;line-height:1;
  }
  .row .body{flex:1;min-width:0;}
  .row .cat{
    display:inline-block;font-size:15px;font-weight:800;letter-spacing:1px;
    color:var(--navy2);background:#e9eef8;padding:3px 10px;border-radius:3px;margin-bottom:6px;
  }
  .row .t{font-size:34px;font-weight:700;letter-spacing:-1.6px;line-height:1.18;color:var(--ink);}
  .row .t em{font-style:normal;color:var(--red);}
  .row .thumb{width:78px;height:78px;flex:none;}
  .row .thumb img{width:100%;height:100%;object-fit:contain;display:block;}

  /* ---------- flow + ticker ---------- */
  .flow{
    margin:0 40px 14px;background:var(--navy);color:#fff;border-radius:4px;
    border-left:7px solid var(--gold);padding:16px 22px;display:flex;gap:16px;align-items:center;
  }
  .flow .lb{font-size:18px;font-weight:800;letter-spacing:0;color:var(--gold);flex:none;}
  .flow .tx{font-size:26px;font-weight:700;letter-spacing:-1.2px;line-height:1.25;}

  .foot{
    background:#101f38;color:#fff;padding:13px 40px;display:flex;align-items:center;gap:26px;
  }
  .foot .mk{display:flex;align-items:baseline;gap:9px;}
  .foot .mk .lb{font-size:17px;font-weight:700;color:#9fb2cd;}
  .foot .mk .v{font-size:23px;font-weight:800;}
  .foot .mk .c{font-size:17px;font-weight:800;}
  .up{color:#ff7a7a;}
  .down{color:#7fb2ff;}
  .foot .handle{margin-left:auto;font-size:18px;font-weight:700;color:#9fb2cd;}
</style>
</head>
<body>
<div class="page">

  <div class="mast">
    <span class="name myeong">{{ paper }}</span>
    <span class="kicker">1면 헤드라인</span>
    <span class="date">{{ date }}</span>
    <span class="day">{{ day_label }}</span>
  </div>

  <div class="hero">
    {% if lead_image %}<img src="{{ lead_image }}">{% endif %}
    <div class="veil"></div>
    <div class="cap">
      <span class="tag">오늘의 톱기사</span>
      <h1 class="myeong">{{ top_headline|safe }}</h1>
      {% if top_sub %}<div class="sub">{{ top_sub }}</div>{% endif %}
    </div>
  </div>

  <div class="list">
    {% for h in headlines %}
    <div class="row">
      <div class="idx">{{ '%02d'|format(loop.index + 1) }}</div>
      <div class="body">
        {% if h.cat %}<span class="cat">{{ h.cat }}</span>{% endif %}
        <div class="t myeong">{{ h.title|safe }}</div>
      </div>
      {% if h.image %}<div class="thumb"><img src="{{ h.image }}"></div>{% endif %}
    </div>
    {% endfor %}
  </div>

  <div class="flow">
    <span class="lb">오늘의 흐름</span>
    <span class="tx myeong">{{ flow }}</span>
  </div>

  <div class="foot">
    {% for m in market %}
    <div class="mk">
      <span class="lb">{{ m.label }}</span>
      <span class="v">{{ m.value }}</span>
      <span class="c {{ 'up' if m.direction == 'up' else 'down' }}">{{ '▲' if m.direction == 'up' else '▼' }} {{ m.change }}</span>
    </div>
    {% endfor %}
    <span class="handle">{{ footer.handle }}</span>
  </div>

</div>
</body>
</html>
