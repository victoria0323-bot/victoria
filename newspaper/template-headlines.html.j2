<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<title>오늘의 1면 제목</title>
<style>
  :root{
    --navy:#12294d;
    --navy2:#1b3a6b;
    --red:#c0392b;
    --ink:#161c28;
    --sub:#5a6577;
    --line:#dbe2ee;
    --bg:#f4f6fb;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    width:1080px;height:1350px;
    background:var(--bg);
    font-family:"Noto Sans KR","Apple SD Gothic Neo","Malgun Gothic",sans-serif;
    color:var(--ink);word-break:keep-all;-webkit-font-smoothing:antialiased;
  }
  .page{width:1080px;height:1350px;padding:34px 38px 26px;display:flex;flex-direction:column;}

  .top{display:flex;align-items:center;gap:14px;margin-bottom:20px;}
  .pill{background:var(--navy);color:#fff;font-weight:900;font-size:27px;padding:10px 22px;border-radius:999px;}
  .paper{font-weight:900;font-size:24px;color:var(--sub);}
  .date{margin-left:auto;font-weight:900;font-size:26px;color:var(--red);}

  .lead{display:flex;gap:22px;align-items:center;margin-bottom:22px;}
  .lead-tx{flex:1;min-width:0;}
  .no1{
    display:inline-block;background:var(--red);color:#fff;font-weight:900;font-size:20px;
    padding:5px 15px;border-radius:999px;margin-bottom:10px;
  }
  h1{margin:0;font-size:56px;line-height:1.14;font-weight:900;color:var(--navy2);letter-spacing:-3px;}
  .lead-img{width:372px;flex:none;}
  .lead-img img{width:100%;border-radius:16px;display:block;}

  .heads{list-style:none;margin:0;padding:0;flex:1;display:flex;flex-direction:column;gap:14px;justify-content:space-between;}
  .heads li{
    background:#fff;border:1.5px solid var(--line);border-radius:16px;
    padding:20px 24px;display:flex;gap:18px;align-items:center;flex:1;
  }
  .heads .n{
    width:42px;height:42px;flex:none;border-radius:50%;background:#eef3ff;color:var(--navy2);
    display:flex;align-items:center;justify-content:center;font-weight:900;font-size:22px;
  }
  .heads .t{font-size:35px;font-weight:900;letter-spacing:-1.6px;line-height:1.2;color:var(--ink);}
  .heads .t em{font-style:normal;color:var(--red);}

  .flow{
    background:var(--navy);color:#fff;border-radius:16px;padding:18px 24px;
    display:flex;gap:16px;align-items:center;margin-top:16px;
  }
  .flow .lb{
    background:#ffd400;color:#3d2c00;font-weight:900;font-size:19px;
    padding:7px 15px;border-radius:999px;flex:none;
  }
  .flow .tx{font-size:27px;font-weight:800;letter-spacing:-1px;line-height:1.3;}

  .mk{display:flex;gap:10px;margin-top:12px;}
  .mk .item{
    flex:1;background:#fff;border:1.5px solid var(--line);border-radius:13px;
    padding:11px 14px;display:flex;align-items:baseline;gap:9px;
  }
  .mk .lb{font-size:19px;font-weight:800;color:var(--sub);}
  .mk .v{font-size:25px;font-weight:900;margin-left:auto;}
  .mk .c{font-size:19px;font-weight:800;}
  .up{color:#e0333f;}
  .down{color:#2f6fed;}

  .credit{margin-top:14px;text-align:center;font-size:19px;font-weight:800;color:var(--sub);}
</style>
</head>
<body>
<div class="page">

  <div class="top">
    <span class="pill">오늘의 1면</span>
    <span class="paper">{{ paper }}</span>
    <span class="date">{{ date }}</span>
  </div>

  <div class="lead">
    <div class="lead-tx">
      <span class="no1">TOP</span>
      <h1>{{ top_headline|safe }}</h1>
    </div>
    {% if lead_image %}<div class="lead-img"><img src="{{ lead_image }}"></div>{% endif %}
  </div>

  <ul class="heads">
    {% for h in headlines %}
    <li><span class="n">{{ loop.index + 1 }}</span><span class="t">{{ h|safe }}</span></li>
    {% endfor %}
  </ul>

  <div class="flow">
    <span class="lb">오늘의 흐름</span>
    <span class="tx">{{ flow }}</span>
  </div>

  <div class="mk">
    {% for m in market %}
    <div class="item">
      <span class="lb">{{ m.label }}</span>
      <span class="v">{{ m.value }}</span>
      <span class="c {{ 'up' if m.direction == 'up' else 'down' }}">{{ '▲' if m.direction == 'up' else '▼' }} {{ m.change }}</span>
    </div>
    {% endfor %}
  </div>

  <div class="credit">{{ footer.tagline }} &nbsp;|&nbsp; {{ footer.handle }}</div>

</div>
</body>
</html>
