<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<title>오늘의 1면 경제신문</title>
<style>
  {% if font_serif_regular %}
  @font-face{
    font-family:'NanumMyeongjoLocal';
    src:url({{ font_serif_regular }}) format('woff2');
    font-weight:400;font-style:normal;font-display:block;
  }
  {% endif %}
  {% if font_serif_bold %}
  @font-face{
    font-family:'NanumMyeongjoLocal';
    src:url({{ font_serif_bold }}) format('woff2');
    font-weight:700;font-style:normal;font-display:block;
  }
  {% endif %}

  :root{
    /* 무채색 + 포인트 컬러 1개 */
    --ink:#16181d;
    --ink-2:#3d434e;
    --muted:#7c8496;
    --faint:#a7adb9;
    --rule:#dcdfe6;
    --rule-soft:#eceef2;
    --paper:#ffffff;
    --accent:#a8121a;
    /* 지표 등락은 장식이 아니라 정보 전달용 색 */
    --up:#a8121a;
    --down:#2f4f7a;

    --serif:'NanumMyeongjoLocal','Nanum Myeongjo','Apple SD Gothic Neo',serif;
    --sans:'Apple SD Gothic Neo','Malgun Gothic','Noto Sans KR',sans-serif;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    width:1080px;
    background:var(--paper);
    font-family:var(--sans);
    color:var(--ink);
    -webkit-font-smoothing:antialiased;
  }
  .page{width:1080px;padding:56px 60px 44px;background:var(--paper);}

  /* ---------- 공용 괘선 ---------- */
  .rule{border:0;border-top:1px solid var(--rule);margin:0;}
  .rule-heavy{border:0;border-top:3px solid var(--ink);margin:0;}

  /* ---------- 섹션 라벨 ---------- */
  .sec-label{display:flex;align-items:baseline;gap:10px;margin-bottom:18px;}
  .sec-label .num{
    font-family:var(--serif);
    font-size:15px;font-weight:700;color:var(--accent);letter-spacing:.5px;
  }
  .sec-label .txt{font-size:13px;font-weight:800;letter-spacing:3.5px;color:var(--ink);}
  .sec-label .meta{
    margin-left:auto;font-size:11.5px;letter-spacing:1.5px;color:var(--faint);font-weight:700;
  }

  /* ---------- 제호 ---------- */
  .masthead{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;}
  .mast-kicker{font-size:11px;font-weight:800;letter-spacing:5px;color:var(--accent);margin-bottom:10px;}
  .wordmark{font-family:var(--serif);font-size:52px;font-weight:700;line-height:1.05;letter-spacing:-1px;}
  .mast-right{text-align:right;padding-bottom:4px;}
  .mast-date{font-family:var(--serif);font-size:24px;font-weight:700;letter-spacing:-.3px;}
  .mast-day{margin-top:7px;font-size:11px;font-weight:800;letter-spacing:3px;color:var(--muted);}
  .mast-rule{margin:18px 0 0;}

  .lede{
    padding:20px 0 22px;
    font-family:var(--serif);
    font-size:25px;line-height:1.5;font-weight:400;color:var(--ink-2);
  }

  /* ---------- 상단 2단 ---------- */
  .grid-top{display:flex;gap:0;padding:34px 0 6px;}
  .grid-top .col-main{flex:1.18;min-width:0;padding-right:42px;}
  .grid-top .col-side{flex:.82;min-width:0;padding-left:42px;border-left:1px solid var(--rule);}

  .core-title{
    font-family:var(--serif);
    font-size:29px;font-weight:700;line-height:1.35;margin:0 0 20px;letter-spacing:-.5px;
  }
  .num-list{list-style:none;margin:0;padding:0;}
  .num-list li{
    display:flex;gap:14px;padding:12px 0;
    border-top:1px solid var(--rule-soft);
    font-size:15px;line-height:1.6;color:var(--ink-2);
  }
  .num-list li:first-child{border-top:none;padding-top:0;}
  .num-list li .idx{
    flex:none;width:20px;
    font-family:var(--serif);font-size:14px;font-weight:700;color:var(--accent);padding-top:2px;
  }
  .core-illo{display:block;width:100%;height:auto;margin-top:24px;}

  /* Market Index */
  .idx-table{display:flex;flex-direction:column;}
  .idx-row{display:flex;align-items:baseline;gap:12px;padding:11px 0;border-top:1px solid var(--rule-soft);}
  .idx-row:first-child{border-top:none;}
  .idx-row .lbl{flex:1;min-width:0;font-size:13.5px;color:var(--muted);font-weight:600;}
  .idx-row .val{
    font-family:var(--serif);
    font-size:21px;font-weight:700;font-variant-numeric:tabular-nums;letter-spacing:-.3px;
  }
  .idx-row .chg{width:88px;text-align:right;font-size:13px;font-weight:700;font-variant-numeric:tabular-nums;}
  .idx-row .chg.up{color:var(--up);}
  .idx-row .chg.down{color:var(--down);}
  .idx-source{
    margin-top:16px;padding-top:12px;border-top:1px solid var(--rule);
    font-size:11px;letter-spacing:1.2px;color:var(--faint);font-weight:700;
  }

  /* ---------- 헤드라인 ---------- */
  .headline{display:flex;gap:40px;align-items:flex-start;padding:38px 0 40px;}
  .headline .h-photo{
    flex:0 0 44%;width:44%;align-self:stretch;min-height:360px;
    background-size:cover;background-position:center;background-color:#eef0f4;
  }
  .headline .h-text{flex:1;min-width:0;}
  .h-title{
    font-family:var(--serif);
    font-size:42px;font-weight:700;line-height:1.24;letter-spacing:-1.4px;margin:0 0 18px;
  }
  .h-sub{
    font-size:16px;font-weight:700;line-height:1.6;color:var(--ink-2);white-space:pre-line;
    padding-bottom:18px;margin-bottom:18px;border-bottom:1px solid var(--rule);
  }
  .h-body{font-size:15px;line-height:1.9;color:var(--ink-2);text-align:justify;}

  /* ---------- 하단 2단 ---------- */
  .grid-bottom{display:flex;gap:0;padding:34px 0 6px;align-items:flex-start;}
  .grid-bottom .col-list{flex:1;min-width:0;padding-right:42px;}
  .grid-bottom .col-side{flex:1;min-width:0;padding-left:42px;border-left:1px solid var(--rule);}

  .read-list{list-style:none;margin:0;padding:0;}
  .read-list li{display:flex;gap:14px;padding:14px 0;border-top:1px solid var(--rule-soft);}
  .read-list li:first-child{border-top:none;padding-top:0;}
  .read-list .idx{
    flex:none;width:20px;
    font-family:var(--serif);font-size:14px;font-weight:700;color:var(--accent);padding-top:3px;
  }
  .read-list .r-title{font-size:16px;font-weight:800;line-height:1.4;letter-spacing:-.3px;}
  .read-list .r-sub{font-size:13.5px;color:var(--muted);line-height:1.5;margin-top:4px;}

  /* 한 줄 요약 — 왼쪽 단 아래를 채우는 풀쿼트 */
  .pullquote{margin-top:34px;padding-top:26px;border-top:3px solid var(--ink);}
  .pullquote .pq-label{font-size:11px;font-weight:800;letter-spacing:3.5px;color:var(--accent);margin-bottom:14px;}
  .pullquote .pq-text{
    font-family:var(--serif);
    font-size:23px;line-height:1.62;font-weight:400;color:var(--ink);letter-spacing:-.5px;
  }
  .pullquote .pq-illo{display:block;width:78px;height:auto;margin:18px 0 0 auto;}

  /* 보조 기사 */
  .sub-item{padding:26px 0;border-top:1px solid var(--rule-soft);}
  .sub-item:first-child{padding-top:0;border-top:none;}
  .sub-photo{
    width:100%;height:150px;margin-bottom:16px;
    background-size:cover;background-position:center;background-color:#eef0f4;
  }
  .sub-title{
    font-family:var(--serif);
    font-size:22px;font-weight:700;line-height:1.35;letter-spacing:-.6px;margin-bottom:11px;
  }
  .sub-body{font-size:14px;line-height:1.75;color:var(--ink-2);text-align:justify;}

  /* ---------- TIP ---------- */
  .tip{position:relative;padding:34px 0 78px;}
  .tip-steps{display:flex;gap:0;margin-top:4px;max-width:70%;}
  .tip-step{flex:1;min-width:0;padding:0 18px;border-left:1px solid var(--rule);}
  .tip-step:first-child{padding-left:0;border-left:none;}
  .tip-step .ts-num{
    font-family:var(--serif);font-size:15px;font-weight:700;color:var(--accent);margin-bottom:8px;
  }
  .tip-step .ts-label{font-size:14px;font-weight:800;letter-spacing:-.3px;margin-bottom:5px;}
  .tip-step .ts-sub{font-size:11.5px;line-height:1.5;color:var(--muted);}
  .character-box{position:absolute;right:0;bottom:0;width:216px;z-index:2;}
  .character-box img{width:100%;height:auto;display:block;}

  /* ---------- 꼬리말 ---------- */
  .footer{
    margin-top:40px;padding-top:18px;border-top:3px solid var(--ink);
    display:flex;align-items:baseline;justify-content:space-between;
  }
  .footer .f-tag{font-family:var(--serif);font-size:19px;font-weight:700;}
  .footer .f-handle{font-size:13px;font-weight:800;letter-spacing:2.5px;color:var(--muted);}
</style>
</head>
<body>
<div class="page">

  <!-- 제호 -->
  <div class="masthead">
    <div>
      <div class="mast-kicker">TODAY'S FRONT PAGE</div>
      <div class="wordmark">오늘의 1면 경제신문</div>
    </div>
    <div class="mast-right">
      <div class="mast-date">{{ date }}</div>
      <div class="mast-day">{{ day_label }}</div>
    </div>
  </div>
  <hr class="rule-heavy mast-rule">

  <div class="lede">{{ hook_text }}</div>
  <hr class="rule">

  <!-- 핵심 뉴스 / Market Index -->
  <div class="grid-top">
    <div class="col-main">
      <div class="sec-label">
        <span class="num">01</span>
        <span class="txt">오늘의 핵심 뉴스</span>
      </div>
      <h2 class="core-title">{{ core_news.title }}</h2>
      <ul class="num-list">
        {% for b in core_news.bullets %}
        <li><span class="idx">{{ '%02d'|format(loop.index) }}</span><span>{{ b }}</span></li>
        {% endfor %}
      </ul>
      {% if core_news.image %}
      <img class="core-illo" src="{{ core_news.image }}" alt="">
      {% endif %}
    </div>

    <div class="col-side">
      <div class="sec-label">
        <span class="txt">MARKET INDEX</span>
        <span class="meta">{{ market_index.date_label }} · {{ market_index.edition }}</span>
      </div>
      <div class="idx-table">
        {% for row in market_index.rows %}
        <div class="idx-row">
          <div class="lbl">{{ row.label }}</div>
          <div class="val">{{ row.value }}</div>
          <div class="chg {{ row.direction }}">
            {%- if row.change %}{{ '▲' if row.direction == 'up' else '▼' }} {{ row.change }}{% endif -%}
          </div>
        </div>
        {% endfor %}
      </div>
      <div class="idx-source">{{ market_index.badge1 }} · {{ market_index.badge2 }}</div>
    </div>
  </div>

  <hr class="rule">

  <!-- 헤드라인 -->
  <div class="headline">
    {% if headline.image %}
    <div class="h-photo" style="background-image:url('{{ headline.image }}');"></div>
    {% endif %}
    <div class="h-text">
      <h1 class="h-title">{{ headline.title }}</h1>
      <div class="h-sub">{{ headline.subtitle }}</div>
      <div class="h-body">{{ headline.body }}</div>
    </div>
  </div>

  <hr class="rule-heavy">

  <!-- 꼭 봐야 할 기사 + 한 줄 요약 / 보조 기사 -->
  <div class="grid-bottom">
    <div class="col-list">
      <div class="sec-label">
        <span class="num">02</span>
        <span class="txt">오늘 꼭 봐야 할 기사</span>
      </div>
      <ul class="read-list">
        {% for a in must_read %}
        <li>
          <span class="idx">{{ '%02d'|format(loop.index) }}</span>
          <div>
            <div class="r-title">{{ a.title }}</div>
            <div class="r-sub">{{ a.sub }}</div>
          </div>
        </li>
        {% endfor %}
      </ul>

      <div class="pullquote">
        <div class="pq-label">한 줄 요약</div>
        <div class="pq-text">{{ summary }}</div>
        {% if summary_image %}
        <img class="pq-illo" src="{{ summary_image }}" alt="">
        {% endif %}
      </div>
    </div>

    <div class="col-side">
      {% for s in sub_articles %}
      <div class="sub-item">
        {% if s.image %}
        <div class="sub-photo" style="background-image:url('{{ s.image }}');"></div>
        {% endif %}
        <div class="sub-title">{{ s.title }}</div>
        <div class="sub-body">{{ s.body }}</div>
      </div>
      {% endfor %}
    </div>
  </div>

  <hr class="rule-heavy">

  <!-- 신문 읽는 TIP -->
  <div class="tip">
    <div class="sec-label">
      <span class="num">03</span>
      <span class="txt">신문 읽는 TIP</span>
    </div>
    <div class="tip-steps">
      {% for step in tip_steps %}
      <div class="tip-step">
        <div class="ts-num">{{ '%02d'|format(loop.index) }}</div>
        <div class="ts-label">{{ step.label }}</div>
        <div class="ts-sub">{{ step.sub }}</div>
      </div>
      {% endfor %}
    </div>
    {% if character_image %}
    <div class="character-box">
      <img src="{{ character_image }}" alt="character">
    </div>
    {% endif %}
  </div>

  <div class="footer">
    <div class="f-tag">{{ footer.tagline }}</div>
    <div class="f-handle">{{ footer.handle }}</div>
  </div>

</div>
</body>
</html>
