<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<title>오늘의 1면 경제신문</title>
<style>
  :root{
    --navy:#0e1b3d;
    --yellow:#ffd400;
    --blue:#2f6fed;
    --blue-light:#eaf1ff;
    --green:#1fa971;
    --green-light:#eafbf3;
    --orange:#ff8a3d;
    --orange-light:#fff3e8;
    --red:#e0333f;
    --red-light:#fdecee;
    --ink:#171923;
    --sub:#5b6472;
    --line:#e4e7ee;
    --card-radius:18px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    width:1080px;
    background:#f5f6fa;
    font-family:"Apple SD Gothic Neo","Malgun Gothic","Noto Sans KR",sans-serif;
    color:var(--ink);
  }
  .page{
    width:1080px;
    padding:28px;
    background:#f5f6fa;
  }

  /* ---------- header ---------- */
  .header-row{
    display:flex;
    gap:16px;
    align-items:stretch;
    margin-bottom:14px;
  }
  .title-badge{
    flex:1;
    background:var(--navy);
    border-radius:20px;
    display:flex;
    align-items:center;
    gap:16px;
    padding:26px 30px;
  }
  .title-badge .news-pill{
    background:#fff;
    color:var(--navy);
    font-weight:800;
    font-size:24px;
    padding:10px 16px;
    border-radius:10px;
    letter-spacing:1px;
  }
  .title-badge .title-text{
    color:#fff;
    font-size:38px;
    font-weight:800;
    line-height:1.15;
  }
  .title-badge .title-text .hi{
    color:var(--yellow);
  }
  .date-box{
    width:260px;
    background:#fff;
    border-radius:20px;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    gap:10px;
    padding:10px;
    border:2px solid var(--navy);
  }
  .date-box .date-line{
    display:flex;
    align-items:center;
    gap:8px;
    font-size:26px;
    font-weight:800;
  }
  .date-box .day-pill{
    background:var(--navy);
    color:#fff;
    font-weight:800;
    font-size:17px;
    padding:5px 16px;
    border-radius:999px;
  }

  .hook-row{
    display:flex;
    align-items:center;
    justify-content:space-between;
    border-bottom:3px solid var(--yellow);
    padding-bottom:12px;
    margin-bottom:20px;
  }
  .hook-row .hook-text{
    font-size:32px;
    font-weight:800;
  }
  .hook-row .hook-text .hi{
    background:linear-gradient(transparent 60%, var(--yellow) 60%);
  }
  .hook-row .hook-icon{font-size:30px;}

  /* ---------- layout ---------- */
  .rows{
    display:flex;
    flex-direction:column;
    gap:16px;
  }
  .row-a{display:flex;gap:16px;align-items:stretch;}
  .row-a > .card{flex:1.15;min-width:0;}
  .row-a > .index-card{flex:0.95;min-width:0;}
  .row-c{display:flex;gap:16px;align-items:stretch;}
  .row-c > .card{flex:1.6;min-width:0;display:flex;flex-direction:column;}
  /* 옆 보조기사 단이 더 길 때 기사 목록을 세로로 펴서 빈 공간을 없앤다 */
  .row-c > .card .article-list{flex:1;justify-content:space-between;}
  .sub-stack{flex:1;min-width:0;display:flex;flex-direction:column;gap:16px;}

  /* ---------- generic card ---------- */
  .card{
    position:relative;
    background:#fff;
    border-radius:var(--card-radius);
    border:2px solid var(--line);
    padding:18px 20px;
  }
  .card-head{
    display:flex;
    align-items:center;
    gap:10px;
    margin-bottom:12px;
  }
  .num-badge{
    width:26px;height:26px;
    border-radius:50%;
    color:#fff;
    display:flex;align-items:center;justify-content:center;
    font-weight:800;font-size:15px;
    flex:none;
  }
  .card-head .card-title{
    font-size:19px;
    font-weight:800;
    flex:1;
  }
  .card-head .icon{font-size:20px;}
  .card-head .head-icon-img{width:30px;height:30px;object-fit:contain;flex:none;}

  .card.accent-blue{border-color:#cfe0ff;}
  .card.accent-green{border-color:#c7ecdb;}
  .card.accent-orange{border-color:#ffdcb8;}
  .card.accent-red{border-color:#f7c9cd;}
  .summary-card{
    background:#fff;
    border:2px solid #f7c9cd;
    border-radius:var(--card-radius);
    padding:18px 20px;
    position:relative;
  }
  .num-badge.blue{background:var(--blue);}
  .num-badge.green{background:var(--green);}
  .num-badge.orange{background:var(--orange);}
  .num-badge.red{background:var(--red);}

  /* card 1: 핵심뉴스 */
  .headline-title{
    font-size:22px;
    font-weight:800;
    line-height:1.35;
    margin:2px 0 12px;
  }
  .bullet-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:9px;}
  .bullet-list li{
    display:flex;gap:8px;
    font-size:15px;
    line-height:1.45;
    color:var(--ink);
  }
  .bullet-list li .chk{flex:none;font-size:15px;margin-top:1px;}
  .core-illustration{width:108px;margin:10px auto 0;display:block;}

  /* card: 오늘 꼭 봐야 할 기사 */
  .article-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px;}
  .article-list li .a-title{font-size:15.5px;font-weight:700;display:flex;gap:6px;}
  .article-list li .a-sub{font-size:13.5px;color:var(--sub);margin:3px 0 0 21px;line-height:1.4;}

  /* card 4: 한줄요약 */
  .summary-text{font-size:15.5px;line-height:1.6;color:var(--ink);}
  .summary-illustration{width:64px;display:block;margin:10px 0 0 auto;}

  /* ---------- right column ---------- */
  .row-flex{display:flex;gap:16px;}
  .row-flex > *{flex:1;min-width:0;}

  .ad-card{
    background:#fff;
    border:2px solid var(--line);
    border-radius:var(--card-radius);
    padding:18px;
    display:flex;
    flex-direction:column;
    gap:10px;
  }
  .ad-brand{font-size:13px;font-weight:800;letter-spacing:2px;color:var(--sub);}
  .ad-visual{
    height:120px;
    border-radius:12px;
    background:linear-gradient(135deg,#dce8ff,#eef4ff);
    display:flex;align-items:center;justify-content:center;
    font-size:34px;
    border:2px dashed #b9cdfa;
    overflow:hidden;
  }
  .ad-visual img{width:100%;height:100%;object-fit:cover;border-radius:10px;}
  .ad-title{font-size:18px;font-weight:800;}
  .ad-meta{font-size:13.5px;color:var(--sub);}

  .index-card{
    background:#fff;
    border:2px solid var(--line);
    border-radius:var(--card-radius);
    padding:16px 18px;
  }
  .index-head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:12px;}
  .index-head .idx-title{font-size:14px;font-weight:800;letter-spacing:.3px;color:var(--navy);}
  .index-head .idx-meta{font-size:11.5px;color:var(--sub);font-weight:600;}
  .index-list{display:flex;flex-direction:column;}
  .index-row{
    display:flex;align-items:center;justify-content:space-between;gap:10px;
    padding:9px 2px;border-bottom:1px solid #f0f1f5;
  }
  .index-row:last-child{border-bottom:none;}
  .index-row .ir-label{font-size:14px;color:var(--sub);font-weight:600;flex:1;min-width:0;}
  .index-row .ir-right{display:flex;align-items:center;gap:10px;flex:none;}
  .index-row .ir-value{font-size:17px;font-weight:800;font-variant-numeric:tabular-nums;}
  .index-badge{
    width:24px;height:24px;border-radius:50%;flex:none;
    display:flex;align-items:center;justify-content:center;
    color:#fff;font-size:11px;
  }
  .index-badge.up{background:var(--red);}
  .index-badge.down{background:var(--blue);}
  .index-row .ir-change{font-size:13px;font-weight:700;width:78px;text-align:right;font-variant-numeric:tabular-nums;}
  .index-row .ir-change.up{color:var(--red);}
  .index-row .ir-change.down{color:var(--blue);}
  .badge-row{display:flex;gap:8px;margin-top:10px;}
  .badge-row .b1,.badge-row .b2{
    flex:1;text-align:center;font-size:12.5px;font-weight:800;
    padding:7px 0;border-radius:8px;
  }
  .badge-row .b1{background:var(--blue-light);color:var(--blue);}
  .badge-row .b2{background:var(--yellow);color:var(--navy);}

  /* top photo (moved above the headline, below Market Index) */
  .top-photo{
    width:100%;
    height:230px;
    border-radius:var(--card-radius);
    overflow:hidden;
    background-size:cover;
    background-position:center;
    background-color:#dfe4ee;
    border:2px solid var(--line);
  }

  /* headline article */
  .headline-card{
    background:#fff;
    border:2px solid var(--line);
    border-radius:var(--card-radius);
    padding:22px 24px;
    display:flex;
    gap:22px;
  }
  .headline-card{flex-direction:column;}
  .headline-card .h-text{width:100%;}
  .h-kicker{font-size:14px;color:var(--sub);font-weight:700;margin-bottom:4px;}
  .h-title{font-size:30px;font-weight:800;line-height:1.3;margin:0 0 14px;}
  .h-sub{font-size:17px;font-weight:700;color:#333c4d;line-height:1.5;margin-bottom:12px;white-space:pre-line;}
  .h-body{font-size:15px;color:var(--sub);line-height:1.75;}
  .headline-card .top-photo{margin-bottom:20px;height:320px;border:none;}

  /* sub articles */
  .sub-card{
    background:#fff;
    border:2px solid var(--line);
    border-radius:var(--card-radius);
    padding:18px 20px;
    display:flex;
    flex-direction:column;
    gap:10px;
  }
  .sub-title{font-size:16.5px;font-weight:800;line-height:1.35;}
  .sub-body{font-size:13.5px;color:var(--sub);line-height:1.6;}
  .sub-icon{
    width:46px;height:46px;border-radius:12px;
    display:flex;align-items:center;justify-content:center;
    font-size:22px;
  }
  .sub-image{width:100%;height:110px;border-radius:12px;overflow:hidden;}
  .sub-image img{width:100%;height:100%;object-fit:cover;display:block;}

  /* tip box */
  .tip-card{
    background:#eef3ff;
    border:2px solid #cddcfb;
    border-radius:var(--card-radius);
    padding:18px 22px;
  }
  .tip-head{display:flex;align-items:center;gap:8px;font-size:17px;font-weight:800;margin-bottom:14px;color:var(--navy);}
  .tip-steps{display:flex;align-items:center;gap:4px;flex-wrap:nowrap;max-width:74%;}
  .tip-step{
    background:#fff;border-radius:12px;padding:8px 6px;
    display:flex;flex-direction:column;align-items:center;gap:4px;
    flex:1;min-width:0;
    border:1px solid #dbe6fb;
  }
  .tip-step .ts-icon{font-size:18px;}
  .tip-step .ts-label{font-size:11.5px;font-weight:800;color:var(--navy);}
  .tip-step .ts-sub{font-size:10px;color:var(--sub);}
  .tip-arrow{font-size:16px;color:#b7c6ea;font-weight:800;}

  .tip-wrap{position:relative;padding-bottom:170px;}
  .character-box{position:absolute;right:-8px;bottom:0;width:260px;z-index:2;}
  .character-box img{width:100%;height:auto;display:block;}

  /* footer */
  .footer-bar{
    margin-top:20px;
    background:var(--navy);
    border-radius:16px;
    padding:22px 22px;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:16px;
    color:#fff;
    font-size:22px;
    font-weight:800;
  }
  .footer-bar .sep{opacity:.5;}
</style>
</head>
<body>
<div class="page">

  <div class="header-row">
    <div class="title-badge">
      <div class="news-pill">NEWS</div>
      <div class="title-text">오늘의 1면 <span class="hi">경제신문</span> ✨</div>
    </div>
    <div class="date-box">
      <div class="date-line">📅 {{ date }}</div>
      <div class="day-pill">{{ day_label }}</div>
    </div>
  </div>

  <div class="hook-row">
    <div class="hook-text"><span class="hi">{{ hook_text }}</span></div>
    <div class="hook-icon">🔍</div>
  </div>

  <div class="rows">

    <div class="row-a">
      <div class="card accent-blue">
        <div class="card-head">
          <div class="num-badge blue">1</div>
          <div class="card-title">오늘의 핵심 뉴스</div>
          <div class="icon">📢</div>
        </div>
        <div class="headline-title">{{ core_news.title }}</div>
        <ul class="bullet-list">
          {% for b in core_news.bullets %}
          <li><span class="chk">✅</span><span>{{ b }}</span></li>
          {% endfor %}
        </ul>
        {% if core_news.image %}
        <img class="core-illustration" src="{{ core_news.image }}" alt="">
        {% endif %}
      </div>

      <div class="index-card">
        <div class="index-head">
          <div class="idx-title">Market Index</div>
          <div class="idx-meta">{{ market_index.date_label }} · {{ market_index.edition }}</div>
        </div>
        <div class="index-list">
          {% for row in market_index.rows %}
          <div class="index-row">
            <div class="ir-label">{{ row.label }}</div>
            <div class="ir-right">
              <div class="ir-value">{{ row.value }}</div>
              {% if row.change %}
              <div class="index-badge {{ row.direction }}">{{ '▲' if row.direction == 'up' else '▼' }}</div>
              <div class="ir-change {{ row.direction }}">{{ row.change }}</div>
              {% endif %}
            </div>
          </div>
          {% endfor %}
        </div>
        <div class="badge-row">
          <div class="b1">{{ market_index.badge1 }}</div>
          <div class="b2">{{ market_index.badge2 }}</div>
        </div>
      </div>
    </div>

    <div class="headline-card">
      {% if headline.image %}
      <div class="top-photo" style="background-image:url('{{ headline.image }}');"></div>
      {% endif %}
      <div class="h-text">
        <div class="h-title">{{ headline.title }}</div>
        <div class="h-sub">{{ headline.subtitle }}</div>
        <div class="h-body">{{ headline.body }}</div>
      </div>
    </div>

    <div class="row-c">
      <div class="card accent-orange">
        <div class="card-head">
          <div class="num-badge orange">2</div>
          <div class="card-title">오늘 꼭 봐야 할 기사</div>
          {% if must_read_image %}
          <img class="head-icon-img" src="{{ must_read_image }}" alt="">
          {% else %}
          <div class="icon">📄</div>
          {% endif %}
        </div>
        <ul class="article-list">
          {% for a in must_read %}
          <li>
            <div class="a-title">✅ {{ a.title }}</div>
            <div class="a-sub">- {{ a.sub }}</div>
          </li>
          {% endfor %}
        </ul>
      </div>

      <div class="sub-stack">
        {% for s in sub_articles %}
        <div class="sub-card">
          {% if s.image %}
          <div class="sub-image"><img src="{{ s.image }}" alt=""></div>
          {% else %}
          <div class="sub-icon" style="background:{{ s.color_bg }};">{{ s.icon }}</div>
          {% endif %}
          <div class="sub-title">{{ s.title }}</div>
          <div class="sub-body">{{ s.body }}</div>
        </div>
        {% endfor %}
      </div>
    </div>

    <div class="summary-card">
      <div class="card-head">
        <div class="num-badge red">3</div>
        <div class="card-title">한 줄 요약</div>
        <div class="icon">💡</div>
      </div>
      <div class="summary-text">{{ summary }}</div>
      {% if summary_image %}
      <img class="summary-illustration" src="{{ summary_image }}" alt="">
      {% endif %}
    </div>

    <div class="tip-wrap">
      <div class="tip-card">
        <div class="tip-head">💡 신문 읽는 TIP</div>
        <div class="tip-steps">
          {% for step in tip_steps %}
          <div class="tip-step">
            <div class="ts-icon">{{ step.icon }}</div>
            <div class="ts-label">{{ step.label }}</div>
            <div class="ts-sub">{{ step.sub }}</div>
          </div>
          {% if not loop.last %}<div class="tip-arrow">→</div>{% endif %}
          {% endfor %}
        </div>
      </div>
      {% if character_image %}
      <div class="character-box">
        <img src="{{ character_image }}" alt="character">
      </div>
      {% endif %}
    </div>

  </div>

  <div class="footer-bar">
    <div>📖 {{ footer.tagline }}</div>
    <div class="sep">|</div>
    <div>{{ footer.handle }} ❤️</div>
  </div>

</div>
</body>
</html>
